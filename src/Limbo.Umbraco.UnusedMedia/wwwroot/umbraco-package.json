{
  "$schema": "../../umbraco-package-schema.json",
  "name": "Limbo Unused Media",
  "version": "17.0.0",
  "allowPackageTelemetry": true,
  "extensions": [
    {
      "type": "dashboard",
      "alias": "Limbo.UnusedMedia.Dashboard",
      "name": "Unused Media",
      "element": "/App_Plugins/Limbo.Umbraco.UnusedMedia/Scripts/dashboard.js",
      "elementName": "limbo-unused-media-dashboard",
      "weight": 20,
      "meta": {
        "label": "#unusedMedia_title",
        "pathname": "unused-media"
      },
      "conditions": [
        {
          "alias": "Umb.Condition.SectionAlias",
          "match": "Umb.Section.Content"
        }
      ]
    },
    {
      "type": "localization",
      "alias": "Limbo.UnusedMedia.Localization.En",
      "name": "English",
      "meta": {
        "culture": "en"
      },
      "js": "/App_Plugins/Limbo.Umbraco.UnusedMedia/Lang/en.js"
    },
    {
      "type": "localization",
      "alias": "Limbo.UnusedMedia.Localization.DaDk",
      "name": "Dansk",
      "meta": {
        "culture": "da-dk"
      },
      "js": "/App_Plugins/Limbo.Umbraco.UnusedMedia/Lang/da-dk.js"
    }
  ]
}
