<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <LimboUmbracoUnusedMediaContentFilesPath>$(MSBuildThisFileDirectory)..\content\App_Plugins\Limbo.Umbraco.UnusedMedia\**\*.*</LimboUmbracoUnusedMediaContentFilesPath>
  </PropertyGroup>

  <Target Name="CopyLimboUmbracoUnusedMediaAssets" BeforeTargets="Build">
    <ItemGroup>
      <LimboUmbracoUnusedMediaContentFiles Include="$(LimboUmbracoUnusedMediaContentFilesPath)" />
    </ItemGroup>
    <Message Text="Copying Limbo.Umbraco.UnusedMedia files: $(LimboUmbracoUnusedMediaContentFilesPath) - #@(LimboUmbracoUnusedMediaContentFiles->Count()) files"  Importance="high" />
    <Copy
      SourceFiles="@(LimboUmbracoUnusedMediaContentFiles)"
      DestinationFiles="@(LimboUmbracoUnusedMediaContentFiles->'$(MSBuildProjectDirectory)\App_Plugins\Limbo.Umbraco.UnusedMedia\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>

  <Target Name="ClearLimboUmbracoUnusedMediaAssets" BeforeTargets="Clean">
    <ItemGroup>
      <LimboUmbracoUnusedMediaDir Include="$(MSBuildProjectDirectory)\App_Plugins\Limbo.Umbraco.UnusedMedia\" />
    </ItemGroup>
    <Message Text="Clear old Limbo.Umbraco.UnusedMedia files"  Importance="high" />
    <RemoveDir Directories="@(LimboUmbracoUnusedMediaDir)"  />
  </Target>

</Project>